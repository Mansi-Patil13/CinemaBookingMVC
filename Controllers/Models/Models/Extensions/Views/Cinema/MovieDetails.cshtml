@model CinemaBookingMVC.Models.Booking
@{
    ViewData["Title"] = "Movie & Booking Details";
    var movie = ViewBag.Movie as CinemaBookingMVC.Models.Movie;
    var movies = ViewBag.Movies as List<CinemaBookingMVC.Models.Movie>;

    var status = Model.GetBookingStatus();
    var totalAmount = Model.CalculateTotalAmount(movies ?? new List<CinemaBookingMVC.Models.Movie>());
}

<div class="container mt-4">
    <h2>Booking & Movie Details</h2>
    <hr />

    @* Conditional Bootstrap Alert Banners[cite: 1] *@
    @if (status == "Completed")
    {
        <div class="alert alert-success">
            <strong>Success:</strong> This booking is completed. Total Amount Paid: ₹@totalAmount[cite: 1]
        </div>
    }
    else if (status == "Today")
    {
        <div class="alert alert-warning">
            <strong>Warning:</strong> The show is scheduled for today! Total Amount Due: ₹@totalAmount[cite: 1]
        </div>
    }
    else if (status == "Cancelled")
    {
        <div class="alert alert-danger">
            <strong>Cancelled:</strong> This booking has been cancelled.[cite: 1]
        </div>
    }
    else if (status == "Upcoming")
    {
        <div class="alert alert-info">
            <strong>Info:</strong> This is an upcoming show. Total Amount: ₹@totalAmount[cite: 1]
        </div>
    }

    <div class="card shadow-sm mt-3">
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h4>Customer Information</h4>
                    <p><strong>Customer Name:</strong> @Model.CustomerName</p>
                    <p><strong>Email:</strong> @Model.Email</p>
                    <p><strong>Phone:</strong> @Model.Phone</p>
                    <p><strong>Booking Date:</strong> @Model.BookingDate.ToString("yyyy-MM-dd HH:mm")</p>
                    <p><strong>Show Date:</strong> @Model.ShowDate.ToString("yyyy-MM-dd")</p>
                    <p><strong>Cancellation Date:</strong> @(Model.CancellationDate.HasValue ? Model.CancellationDate.Value.ToString("yyyy-MM-dd") : "N/A")</p>
                </div>
                <div class="col-md-6">
                    <h4>Movie Information</h4>
                    <p><strong>Movie Name:</strong> @(movie?.MovieName ?? "N/A")</p>
                    <p><strong>Genre:</strong> @(movie?.Genre ?? "N/A")</p>
                    <p><strong>Language:</strong> @(movie?.Language ?? "N/A")</p>
                    <p><strong>Ticket Price:</strong> ₹@(movie?.TicketPrice ?? 0)</p>
                    <p><strong>Tickets Booked:</strong> @Model.NumberOfTickets</p>
                    <p><strong>Booking Status:</strong> @status</p>
                    <p><strong>Total Amount:</strong> ₹@totalAmount</p>
                </div>
            </div>
        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">Back to List</a>
    </div>
</div>
